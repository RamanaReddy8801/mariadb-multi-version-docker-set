# Example environment file
# Copy this to .env and customize the values
# DO NOT use these example values in production!

# MariaDB 10
MARIADB_10_ROOT_PASSWORD=your_root_password_here
MARIADB_10_DATABASE=your_database_name
MARIADB_10_USER=your_username
MARIADB_10_PASSWORD=your_password_here
MARIADB_10_PORT=3310

# MariaDB 11
MARIADB_11_ROOT_PASSWORD=your_root_password_here
MARIADB_11_DATABASE=your_database_name
MARIADB_11_USER=your_username
MARIADB_11_PASSWORD=your_password_here
MARIADB_11_PORT=3311

# MariaDB 12
MARIADB_12_ROOT_PASSWORD=your_root_password_here
MARIADB_12_DATABASE=your_database_name
MARIADB_12_USER=your_username
MARIADB_12_PASSWORD=your_password_here
MARIADB_12_PORT=3312

